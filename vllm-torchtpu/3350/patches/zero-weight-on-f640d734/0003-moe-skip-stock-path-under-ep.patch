From 586e11bc2d8a11a6fd0a936eb3ac2c2fc52c9e75 Mon Sep 17 00:00:00 2001
From: Summer Yang <xiaotongyang@google.com>
Date: Sun, 15 Nov 2026 07:01:56 +0000
Subject: [PATCH] [MoE] Keep the stock path in the unquantized MoE under expert
 parallelism

With TPU_MOE_SKIP_PADDED_TOKENS=1 and expert parallelism, skipping padded routes changed the chosen-token logprobs of real rows in some batches (token ids unchanged), so the bf16 MoE no longer matched the stock path exactly. Until that is understood, the method keeps the stock path under EP: the bool read in __init__ becomes False there, with one warning, so the zeroing, the kernel prebuild and the runtime kernel selection all stay on the stock path together. Other MoE methods and the runner's padding mask are unchanged.
---
 .../adapter/quantization/unquantized.py       | 15 ++++-
 .../quantization/test_unquantized_moe_skip.py | 66 ++++++++++++++++++-
 2 files changed, 77 insertions(+), 4 deletions(-)

diff --git a/src/vllm_torchtpu/layers/adapter/quantization/unquantized.py b/src/vllm_torchtpu/layers/adapter/quantization/unquantized.py
index 78dcdc2a9..9298527fc 100644
--- a/src/vllm_torchtpu/layers/adapter/quantization/unquantized.py
+++ b/src/vllm_torchtpu/layers/adapter/quantization/unquantized.py
@@ -261,8 +261,19 @@ class VllmUnquantizedFusedMoEMethod(TpuMoEActivationMixin, UnquantizedFusedMoEMe
         # TPU_MOE_SKIP_PADDED_TOKENS is read once here. The same bool decides
         # whether the forward zeroes the padded rows' routing weights and is
         # passed to the kernel prebuild and to the runtime kernel selection,
-        # so the three always agree.
-        self._skip_padded_tokens = bool(envs.TPU_MOE_SKIP_PADDED_TOKENS)
+        # so the three always agree. With expert parallelism the bf16 MoE
+        # keeps the stock path: skipping padded routes there changed the
+        # chosen-token logprobs of real rows (token ids unchanged), and this
+        # method promises outputs identical to the stock path.
+        skip_padded_tokens = bool(envs.TPU_MOE_SKIP_PADDED_TOKENS)
+        if skip_padded_tokens and moe.moe_parallel_config.use_ep:
+            logger.warning_once(
+                "TPU_MOE_SKIP_PADDED_TOKENS is not applied to the bf16 MoE with "
+                "expert parallelism; it runs the stock path (no zeroing of padded "
+                "routes, stock GMM kernel)."
+            )
+            skip_padded_tokens = False
+        self._skip_padded_tokens = skip_padded_tokens
 
     @property
     def is_monolithic(self) -> bool:
diff --git a/tests/layers/adapter/quantization/test_unquantized_moe_skip.py b/tests/layers/adapter/quantization/test_unquantized_moe_skip.py
index 1ba09c8aa..8fe2fa8ec 100644
--- a/tests/layers/adapter/quantization/test_unquantized_moe_skip.py
+++ b/tests/layers/adapter/quantization/test_unquantized_moe_skip.py
@@ -155,15 +155,77 @@ def test_bf16_branch_does_not_read_env(routed, monkeypatch):
         _forward(_method(skip))
 
 
+def _moe_config(use_ep: bool) -> SimpleNamespace:
+    return SimpleNamespace(moe_parallel_config=SimpleNamespace(use_ep=use_ep))
+
+
+@pytest.mark.parametrize("use_ep", [False, True])
 @pytest.mark.parametrize("flag", [False, True])
-def test_flag_read_at_construction(monkeypatch, flag):
+def test_flag_read_at_construction(monkeypatch, flag, use_ep):
+    """The flag is read once at construction; under expert parallelism the
+    bf16 MoE keeps the stock path whatever the flag says."""
     monkeypatch.setattr(
         module.UnquantizedFusedMoEMethod, "__init__", lambda self, moe: None
     )
     monkeypatch.setattr(
         module, "envs", SimpleNamespace(TPU_MOE_SKIP_PADDED_TOKENS=flag)
     )
-    assert VllmUnquantizedFusedMoEMethod(None)._skip_padded_tokens is flag
+    warnings = []
+    monkeypatch.setattr(
+        module.logger,
+        "warning_once",
+        lambda msg, *a: warnings.append(msg),
+        raising=False,
+    )
+    method = VllmUnquantizedFusedMoEMethod(_moe_config(use_ep))
+    assert method._skip_padded_tokens is (flag and not use_ep)
+    assert len(warnings) == (1 if flag and use_ep else 0)
+
+
+def test_ep_keeps_stock_zeroing_prebuild_and_kernel(
+    routes, kernel_selector, monkeypatch
+):
+    """With the flag on under EP, the constructed method neither zeroes padded
+    routes nor prebuilds or selects the skipping kernel: the three use the one
+    effective bool."""
+    monkeypatch.setattr(
+        module.UnquantizedFusedMoEMethod, "__init__", lambda self, moe: None
+    )
+    monkeypatch.setattr(
+        module, "envs", SimpleNamespace(TPU_MOE_SKIP_PADDED_TOKENS=True)
+    )
+    monkeypatch.setattr(module.logger, "warning_once", lambda *a: None, raising=False)
+    monkeypatch.setattr(
+        module, "enable_pipelined_collective_and_compute", lambda: False
+    )
+
+    class _Experts(SimpleNamespace):
+        pass
+
+    monkeypatch.setattr(module, "RoutedExperts", _Experts)
+    monkeypatch.setattr(
+        module.moe_routing, "register_experts_start_buffer", lambda *a, **k: None
+    )
+    monkeypatch.setattr(
+        module.moe_routing, "validate_linear_ep_placement", lambda *a, **k: None
+    )
+    method = VllmUnquantizedFusedMoEMethod(_moe_config(True))
+    method._tpu_activation_str = "silu"
+    method.moe = SimpleNamespace(has_bias=False)
+    method._set_tpu_activation = lambda layer: "silu"
+    layer = _Experts(
+        w13_weight=torch.nn.Parameter(torch.zeros(2, 256, 128), requires_grad=False),
+        w2_weight=torch.nn.Parameter(torch.zeros(2, 128, 128), requires_grad=False),
+        moe_config=SimpleNamespace(
+            experts_per_token=_TOPK,
+            moe_parallel_config=SimpleNamespace(use_ep=False),
+        ),
+    )
+    method.process_weights_after_loading(layer)
+    x = torch.ones(4, 128, dtype=torch.bfloat16)
+    assert _forward(method, x) is x
+    assert kernel_selector.cache.lookups == [(_TOPK, "silu", False, None, False)] * 2
+    assert routes.calls == []
 
 
 @pytest.mark.parametrize("pipelined", [False, True])
-- 
