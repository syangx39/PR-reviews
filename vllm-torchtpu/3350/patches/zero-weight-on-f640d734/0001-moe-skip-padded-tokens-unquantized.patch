+"""TPU_MOE_SKIP_PADDED_TOKENS in the unquantized (bf16) fused MoE method."""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm_torchtpu.layers.adapter.quantization import unquantized as module
+from vllm_torchtpu.layers.adapter.quantization.unquantized import (
+    VllmUnquantizedFusedMoEMethod,
+)
+
+
+def _method(skip_padded_tokens: bool) -> VllmUnquantizedFusedMoEMethod:
+    method = VllmUnquantizedFusedMoEMethod.__new__(VllmUnquantizedFusedMoEMethod)
+    method._tpu_activation_str = "silu"
+    method._skip_padded_tokens = skip_padded_tokens
+    return method
+
+
+def _layer() -> SimpleNamespace:
+    return SimpleNamespace(
+        w13_weight=None,
+        w2_weight=None,
+        _experts_start=None,
+        moe_config=SimpleNamespace(experts_per_token=2),
+    )
+
+
+@pytest.fixture
+def routed(monkeypatch):
+    ids = torch.tensor([[1, 2], [3, 4], [5, 6], [7, 8]], dtype=torch.int32)
+    weights = torch.full((4, 2), 0.5)
+    calls = []
+
+    def mask(topk_ids, topk_weights, is_local_tensor):
+        calls.append(is_local_tensor)
+        topk_weights = topk_weights.clone()
+        topk_weights[-1] = 0  # last row is padding
+        return topk_ids, topk_weights
+
+    monkeypatch.setattr(module.moe_routing, "route", lambda *args: (weights, ids))
+    monkeypatch.setattr(module.token_padding, "zero_routing_weights_for_padding", mask)
+    monkeypatch.setattr(
+        module, "enable_pipelined_collective_and_compute", lambda: False
+    )
+    monkeypatch.setattr(module, "fused_moe_gmm", lambda **kwargs: kwargs)
+    return SimpleNamespace(ids=ids, weights=weights, calls=calls)
+
+
+def test_padded_rows_get_zero_weight_when_enabled(routed):
+    out = _method(True)._forward_monolithic_tpu(
+        _layer(), torch.ones(4, 128, dtype=torch.bfloat16), torch.zeros(4, 8)
+    )
+    assert routed.calls == [False]
+    torch.testing.assert_close(out["topk_ids"], routed.ids)
+    assert out["topk_weights"][-1].count_nonzero() == 0
+    torch.testing.assert_close(out["topk_weights"][:-1], routed.weights[:-1])
+
+
+def test_routes_unchanged_when_disabled(routed):
+    out = _method(False)._forward_monolithic_tpu(
+        _layer(), torch.ones(4, 128, dtype=torch.bfloat16), torch.zeros(4, 8)
+    )
+    assert routed.calls == []
+    torch.testing.assert_close(out["topk_weights"], routed.weights)
+
+
+def test_forward_does_not_read_env(routed, monkeypatch):
+    """The flag is read at construction; the compiled forward must not touch envs."""
+
+    class _NoEnv:
+        def __getattr__(self, name):
+            raise AssertionError(f"forward read envs.{name}")
+
+    monkeypatch.setattr(module, "envs", _NoEnv())
+    for skip in (False, True):
+        _method(skip)._forward_monolithic_tpu(
+            _layer(), torch.ones(4, 128, dtype=torch.bfloat16), torch.zeros(4, 8)
+        )
+
+
+@pytest.mark.parametrize("flag", [False, True])
+def test_flag_read_at_construction(monkeypatch, flag):
+    monkeypatch.setattr(
+        module.UnquantizedFusedMoEMethod, "__init__", lambda self, moe: None
+    )
+    monkeypatch.setattr(
+        module, "envs", SimpleNamespace(TPU_MOE_SKIP_PADDED_TOKENS=flag)
+    )
+    assert VllmUnquantizedFusedMoEMethod(None)._skip_padded_tokens is flag
