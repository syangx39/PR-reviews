 method (TPU_MOE_SKIP_PADDED_TOKENS)

---
 .../adapter/quantization/unquantized.py       |  18 ++-
 .../quantization/test_unquantized_moe_skip.py | 104 ++++++++++++++++++
 2 files changed, 121 insertions(+), 1 deletion(-)
 create mode 100644 tests/layers/adapter/quantization/test_unquantized_moe_skip.py

diff --git a/src/vllm_torchtpu/layers/adapter/quantization/unquantized.py b/src/vllm_torchtpu/layers/adapter/quantization/unquantized.py
index c085caa42..9ca313652 100644
--- a/src/vllm_torchtpu/layers/adapter/quantization/unquantized.py
+++ b/src/vllm_torchtpu/layers/adapter/quantization/unquantized.py
@@ -54,7 +54,8 @@ from vllm.model_executor.layers.vocab_parallel_embedding import (
 )
 from vllm.model_executor.utils import replace_parameter
 
-from vllm_torchtpu.layers.adapter import moe_routing
+from vllm_torchtpu import envs
+from vllm_torchtpu.layers.adapter import moe_routing, token_padding
 from vllm_torchtpu.layers.adapter.fused_moe import (
     TpuMoEActivationMixin,
     fused_moe_gmm,
@@ -257,6 +258,11 @@ class VllmUnquantizedFusedMoEMethod(TpuMoEActivationMixin, UnquantizedFusedMoEMe
         # Parent sets _is_monolithic=False on TPU and skips wiring
         # apply_monolithic.  Override both after super().__init__().
         self.apply_monolithic = self._select_monolithic()
+        # TPU_MOE_SKIP_PADDED_TOKENS is read once here, outside the compiled
+        # forward: the fused GMM kernel is built with the same flag
+        # (prebuild_fused_moe_kernel), and the forward only branches on this
+        # Python bool.
+        self._skip_padded_tokens = bool(envs.TPU_MOE_SKIP_PADDED_TOKENS)
 
     @property
     def is_monolithic(self) -> bool:
@@ -375,6 +381,16 @@ class VllmUnquantizedFusedMoEMethod(TpuMoEActivationMixin, UnquantizedFusedMoEMe
         # methods so the routing-simulation hook lives in exactly one place.
         topk_weights, topk_ids = moe_routing.route(layer, x, router_logits)
 
+        # Padded rows keep their expert ids and get zero gate weight; the GMM
+        # kernel built with skip_padded_tokens leaves zero-weight entries out
+        # of the expert groups (as in the FP8 and MXFP4 MoE methods).
+        if getattr(self, "_skip_padded_tokens", False):
+            topk_ids, topk_weights = token_padding.zero_routing_weights_for_padding(
+                topk_ids,
+                topk_weights,
+                is_local_tensor=enable_pipelined_collective_and_compute(),
+            )
+
         kwargs = {
             "hidden_states": x,
             "w1": layer.w13_weight,
