From 7e4d170a5d21eb167eae43bcb93e554505e4286e Mon Sep 17 00:00:00 2001
From: Summer Yang <xiaotongyang@google.com>
Date: Sun, 15 Nov 2026 01:16:43 +0000
Subject: [PATCH 2/2] [MoE] Pass the cached skip flag to the kernel prebuild
 and selection

The unquantized MoE method reads TPU_MOE_SKIP_PADDED_TOKENS once in __init__. Pass that bool to prebuild_fused_moe_kernel and, through the common kwargs, to fused_moe_gmm and pipelined_fused_moe_gmm, so the zeroing of padded routes, the prebuilt kernel and the runtime kernel selection use the same value instead of the selector reading the env when skip_padded_tokens is None.
---
 .../adapter/quantization/unquantized.py       |  12 +-
 .../quantization/test_unquantized_moe_skip.py | 142 ++++++++++++++++--
 2 files changed, 134 insertions(+), 20 deletions(-)

diff --git a/src/vllm_torchtpu/layers/adapter/quantization/unquantized.py b/src/vllm_torchtpu/layers/adapter/quantization/unquantized.py
index 9ca313652..78dcdc2a9 100644
--- a/src/vllm_torchtpu/layers/adapter/quantization/unquantized.py
+++ b/src/vllm_torchtpu/layers/adapter/quantization/unquantized.py
@@ -258,10 +258,10 @@ class VllmUnquantizedFusedMoEMethod(TpuMoEActivationMixin, UnquantizedFusedMoEMe
         # Parent sets _is_monolithic=False on TPU and skips wiring
         # apply_monolithic.  Override both after super().__init__().
         self.apply_monolithic = self._select_monolithic()
-        # TPU_MOE_SKIP_PADDED_TOKENS is read once here, outside the compiled
-        # forward: the fused GMM kernel is built with the same flag
-        # (prebuild_fused_moe_kernel), and the forward only branches on this
-        # Python bool.
+        # TPU_MOE_SKIP_PADDED_TOKENS is read once here. The same bool decides
+        # whether the forward zeroes the padded rows' routing weights and is
+        # passed to the kernel prebuild and to the runtime kernel selection,
+        # so the three always agree.
         self._skip_padded_tokens = bool(envs.TPU_MOE_SKIP_PADDED_TOKENS)
 
     @property
@@ -360,6 +360,7 @@ class VllmUnquantizedFusedMoEMethod(TpuMoEActivationMixin, UnquantizedFusedMoEMe
             topk=layer.moe_config.experts_per_token,
             activation=activation_str,
             use_ep=layer.moe_config.moe_parallel_config.use_ep,
+            skip_padded_tokens=self._skip_padded_tokens,
         )
 
     def _forward_monolithic_tpu(
@@ -384,7 +385,7 @@ class VllmUnquantizedFusedMoEMethod(TpuMoEActivationMixin, UnquantizedFusedMoEMe
         # Padded rows keep their expert ids and get zero gate weight; the GMM
         # kernel built with skip_padded_tokens leaves zero-weight entries out
         # of the expert groups (as in the FP8 and MXFP4 MoE methods).
-        if getattr(self, "_skip_padded_tokens", False):
+        if self._skip_padded_tokens:
             topk_ids, topk_weights = token_padding.zero_routing_weights_for_padding(
                 topk_ids,
                 topk_weights,
@@ -404,6 +405,7 @@ class VllmUnquantizedFusedMoEMethod(TpuMoEActivationMixin, UnquantizedFusedMoEMe
             "experts_start": layer._experts_start,
             "topk": layer.moe_config.experts_per_token,
             "activation": activation_str,
+            "skip_padded_tokens": self._skip_padded_tokens,
         }
         if enable_pipelined_collective_and_compute():
             return pipelined_fused_moe_gmm(**kwargs)
