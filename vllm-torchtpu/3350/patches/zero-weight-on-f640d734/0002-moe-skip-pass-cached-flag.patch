-def test_padded_rows_get_zero_weight_when_enabled(routed):
-    out = _method(True)._forward_monolithic_tpu(
-        _layer(), torch.ones(4, 128, dtype=torch.bfloat16), torch.zeros(4, 8)
+class _SkipFlagUnreadable:
+    """Stands in for vllm_torchtpu.envs; reading the skip flag fails."""
+
+    def __init__(self, real):
+        self._real = real
+
+    def __getattr__(self, name):
+        if name == "TPU_MOE_SKIP_PADDED_TOKENS":
+            raise AssertionError("read envs.TPU_MOE_SKIP_PADDED_TOKENS")
+        return getattr(self._real, name)
+
+
+class _RecordingKernelCache(dict):
+    def __init__(self):
+        super().__init__()
+        self.lookups = []
+
+    def get(self, key, default=None):
+        self.lookups.append(key)
+        return super().get(key, default)
+
+
+@pytest.fixture
+def kernel_selector(monkeypatch):
+    """The real wrappers and kernel selector, with CPU fake kernels in the
+    selector's cache for both skip values and the skip flag unreadable from
+    envs, so a lookup only succeeds when the flag is passed explicitly."""
+    cache = _RecordingKernelCache()
+    calls = []
+    for skip in (False, True):
+
+        def fake_kernel(*args, _skip=skip):
+            calls.append((_skip, args))
+            return args[0]
+
+        # Key layout of _get_fused_moe_custom_op:
+        # (topk, activation, use_ep, rhs_quant_dtype, skip_padded_tokens).
+        cache[(_TOPK, "silu", False, None, skip)] = fake_kernel
+    monkeypatch.setattr(fused_moe_module, "_fused_moe_kernel_cache", cache)
+    for mod in (module, fused_moe_module, pipelined_module):
+        monkeypatch.setattr(mod, "envs", _SkipFlagUnreadable(mod.envs))
+    # A single rank: the pipelined wrapper goes straight to fused_moe_gmm.
+    monkeypatch.setattr(
+        pipelined_module, "_get_moe_collective_group", lambda: (None, None)
     )
+    return SimpleNamespace(cache=cache, calls=calls)
+
+
+def test_padded_rows_get_zero_weight_when_enabled(routed):
+    out = _forward(_method(True))
     assert routed.calls == [False]
     torch.testing.assert_close(out["topk_ids"], routed.ids)
     assert out["topk_weights"][-1].count_nonzero() == 0
     torch.testing.assert_close(out["topk_weights"][:-1], routed.weights[:-1])
+    assert out["skip_padded_tokens"] is True
 
 
