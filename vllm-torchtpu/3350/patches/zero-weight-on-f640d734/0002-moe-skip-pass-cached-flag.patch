+@pytest.mark.parametrize("pipelined", [False, True])
+@pytest.mark.parametrize("flag", [False, True])
+def test_kernel_selection_gets_cached_flag(
+    routes, kernel_selector, monkeypatch, flag, pipelined
+):
+    """The cached bool reaches the kernel selector through the real
+    fused_moe_gmm / pipelined_fused_moe_gmm wrappers, without an env read."""
+    monkeypatch.setattr(
+        module, "enable_pipelined_collective_and_compute", lambda: pipelined
+    )
+    x = torch.ones(4, 128, dtype=torch.bfloat16)
+    assert _forward(_method(flag), x) is x
+    assert kernel_selector.cache.lookups == [(_TOPK, "silu", False, None, flag)]
+    ((skip, args),) = kernel_selector.calls
+    assert skip is flag
+    assert routes.calls == ([pipelined] if flag else [])
+    topk_weights = args[7]
+    assert (topk_weights[-1].count_nonzero().item() == 0) is flag
+
+
+@pytest.mark.parametrize("flag", [False, True])
+def test_prebuild_gets_cached_flag(kernel_selector, monkeypatch, flag):
+    """process_weights_after_loading prebuilds the kernel for the cached bool,
+    through the real prebuild_fused_moe_kernel and selector."""
+
+    class _Experts(SimpleNamespace):
+        pass
+
+    monkeypatch.setattr(module, "RoutedExperts", _Experts)
+    monkeypatch.setattr(
+        module.moe_routing, "register_experts_start_buffer", lambda *a, **k: None
+    )
+    # Plain assignments: the method object is local to the test, and
+    # monkeypatch could not undo attributes on a module built with __new__.
+    method = _method(flag)
+    method.moe = SimpleNamespace(has_bias=False)
+    method._set_tpu_activation = lambda layer: "silu"
+    layer = _Experts(
+        w13_weight=torch.nn.Parameter(torch.zeros(2, 256, 128), requires_grad=False),
+        w2_weight=torch.nn.Parameter(torch.zeros(2, 128, 128), requires_grad=False),
+        moe_config=SimpleNamespace(
+            experts_per_token=_TOPK,
+            moe_parallel_config=SimpleNamespace(use_ep=False),
+        ),
+    )
+    method.process_weights_after_loading(layer)
+    assert kernel_selector.cache.lookups == [(_TOPK, "silu", False, None, flag)]
+    assert kernel_selector.calls == []
