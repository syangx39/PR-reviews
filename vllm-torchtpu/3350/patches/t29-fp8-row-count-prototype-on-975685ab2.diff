+    monkeypatch.setattr(module, "prebuild_fused_moe_kernel", lambda **kw: None)
+    monkeypatch.setattr(
+        module.moe_routing, "register_experts_start_buffer", lambda *a, **k: None
+    )
+    monkeypatch.setattr(
+        fused_moe_ep_module, "prebuild_fused_moe_ep", lambda *a, **k: None
+    )
+    loaded = _loaded()
+    monkeypatch.setattr(
+        module,
+        "_process_fp8_moe_weights",
+        lambda layer, **kw: (
+            loaded.w13_weight,
+            loaded.w13_weight_scale_inv,
+            loaded.w2_weight,
+            loaded.w2_weight_scale_inv,
+            "float8_e4m3fn",
+            None,
+        ),
+    )
+    monkeypatch.delenv("MOE_FUSED_EP_KERNEL_IMPL", raising=False)
+    method = _method(row_count=True)
+    method.moe = SimpleNamespace(has_bias=False)
+    method.quant_config = SimpleNamespace(is_checkpoint_fp8_serialized=True)
+    method.weight_block_size = [128, 128]
+    method.weight_scale_name = "weight_scale_inv"
+    method._set_tpu_activation = lambda layer: "silu"
