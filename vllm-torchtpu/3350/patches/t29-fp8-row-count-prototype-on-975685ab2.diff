     if fallback_reason is not None:
         return Bf16MoeSkipPolicy(enabled=False, fallback_reason=fallback_reason)
     return Bf16MoeSkipPolicy(enabled=True)
+
+
+# Experiment (t29, not part of #3350): the FP8 MoE row-count filter.
+#
+# With TPU_MOE_SKIP_PADDED_TOKENS=1 and TPU_MOE_SKIP_FP8_ROW_COUNT=1,
+# VllmFp8MoEMethodTPU's ordinary routed-GMM path drops padded rows by row index
+# (PaddedRowFilter.ROW_COUNT) instead of zeroing their routing weights. Every
+# other FP8 path (adaptive fused MoE, fused EP, moe_tp_decode, the pipelined
+# collective / FP8 all-gather, fused_moe_decode, the dense-expert kernel) and
+# every other topology keeps the parent's behavior for the same skip flag (the
+# ordinary path zeroes padded rows' weights when the flag is set; the special
+# paths keep their own handling). Admission contract: only a
+# native serialized FP8 (e4m3) checkpoint with the default runtime layout
+# (MOE_REQUANTIZE_WEIGHT_DTYPE=float8_e4m3fn, no MOE_REQUANTIZE_BLOCK_SIZE, i.e.
+# per-channel scales); the runner re-checks the loaded layers.
+
+_active_fp8_row_count_policy: Fp8RowCountPolicy | None = None
+
+
+@dataclass(frozen=True)
+class Fp8RowCountPolicy:
+    """Whether FP8 MoE layers use the row-count filter, and why not if not."""
+
+    enabled: bool
+    fallback_reason: str | None = None
+
+
+@contextlib.contextmanager
+def fp8_row_count_scope(policy: Fp8RowCountPolicy) -> Iterator[None]:
+    """Publish the runner's FP8 row-count policy to the layers built in it."""
+    global _active_fp8_row_count_policy
+    prev = _active_fp8_row_count_policy
+    _active_fp8_row_count_policy = policy
+    try:
+        yield
+    finally:
+        _active_fp8_row_count_policy = prev
+
+
+def get_active_fp8_row_count_policy() -> Fp8RowCountPolicy | None:
+    """Return the policy published by ``fp8_row_count_scope``, if any."""
+    return _active_fp8_row_count_policy
+
+
+def resolve_fp8_row_count_policy(
+    *,
+    skip_flag: bool,
+    row_count_flag: bool,
+    parallel_config: ParallelConfig,
+    is_fp8_model: bool,
+    checkpoint_fp8_serialized: bool,
+    requant_weight_dtype: str | None,
+    requant_block_size: int | None,
+    pipelined_collective: bool,
+    fp8_all_gather: bool,
+    fused_ep_kernel: bool,
+    fused_decode_kernel: bool,
+    dense_expert_kernel: bool,
+    sequence_parallel: bool,
+    has_speculative: bool,
+    has_lora: bool,
+) -> Fp8RowCountPolicy:
+    """Resolve the experiment policy before any MoE layer or kernel prebuild."""
+    if not (skip_flag and row_count_flag):
+        return Fp8RowCountPolicy(enabled=False)
+    fallback_reason: str | None = None
+    if not is_fp8_model:
+        fallback_reason = "not an FP8 model"
+    elif not checkpoint_fp8_serialized:
+        fallback_reason = "quantize-on-load (checkpoint not FP8-serialized)"
+    elif (requant_weight_dtype or "float8_e4m3fn") != "float8_e4m3fn":
+        fallback_reason = (
+            f"MOE_REQUANTIZE_WEIGHT_DTYPE={requant_weight_dtype} (only float8_e4m3fn)"
+        )
+    elif requant_block_size:
+        fallback_reason = (
+            f"MOE_REQUANTIZE_BLOCK_SIZE={requant_block_size} "
+            "(only the default per-channel runtime scales)"
+        )
+    elif parallel_config.enable_expert_parallel:
+        fallback_reason = "expert parallelism"
+    else:
+        for name, size in (
+            ("data_parallel_size", parallel_config.data_parallel_size),
+            ("pipeline_parallel_size", parallel_config.pipeline_parallel_size),
+            (
+                "prefill_context_parallel_size",
+                parallel_config.prefill_context_parallel_size,
+            ),
+            (
+                "decode_context_parallel_size",
+                parallel_config.decode_context_parallel_size,
+            ),
+        ):
+            if size > 1:
+                fallback_reason = f"{name} > 1"
+                break
+    for flag, reason in (
+        (
+            pipelined_collective,
+            "pipelined MoE collective (TPU_MOE_COLLECTION_CHUNK_SIZE)",
+        ),
+        (fp8_all_gather, "FP8 all-gather (TPU_MOE_FP8_ALL_GATHER)"),
+        (fused_ep_kernel, "fused EP / adaptive MoE kernel"),
+        (fused_decode_kernel, "fused MoE decode kernels"),
+        (dense_expert_kernel, "dense-expert MoE (TPU_MOE_DENSE_EXPERT_THRESHOLD)"),
+        (sequence_parallel, "MoE sequence parallelism (TPU_MOE_SEQUENCE_PARALLEL)"),
+        (has_speculative, "speculative decoding"),
+        (has_lora, "LoRA"),
+    ):
+        if fallback_reason is None and flag:
+            fallback_reason = reason
+    if fallback_reason is not None:
+        return Fp8RowCountPolicy(enabled=False, fallback_reason=fallback_reason)
+    return Fp8RowCountPolicy(enabled=True)
