+def _loaded(w_dtype=torch.float8_e4m3fn, s_shape13=None, s_dtype=torch.float32):
+    """A layer as process_weights_after_loading leaves it: w13 [E, H, 2I], w2
+    [E, I, H] and per-channel scales [E, 1, 1, N]."""
+    e, h, i = 2, 128, 64
+    return SimpleNamespace(
+        w13_weight=torch.zeros(e, h, 2 * i).to(w_dtype),
+        w2_weight=torch.zeros(e, i, h).to(w_dtype),
+        w13_weight_scale_inv=torch.ones(s_shape13 or (e, 1, 1, 2 * i), dtype=s_dtype),
+        w2_weight_scale_inv=torch.ones(e, 1, 1, h, dtype=s_dtype),
+    )
