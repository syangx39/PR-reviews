+@pytest.mark.tpu_test
+@pytest.mark.parametrize(
+    "num_tokens,num_valid", [(16, 0), (16, 1), (16, 9), (16, 16), (32, 17), (256, 255)]
+)
+def test_fp8_row_count_matches_stock_on_real_rows(num_tokens, num_valid):
+    """FP8 expert weights in the kernel layout of VllmFp8MoEMethodTPU
+    (float8_e4m3fn, per-channel float32 scales [E, 1, 1, N]): the row-count
+    filter leaves real rows bit-identical to stock (a real zero gate
+    included) and drops the padded rows, whose gates are non-zero."""
+    import jax
+    import numpy as np
+    from jax import numpy as jnp
+
+    from vllm_torchtpu.layers.core.fused_moe_gmm import fused_moe_func
+
+    if jax.default_backend() != "tpu":
+        pytest.skip("needs a TPU")
+    num_experts, hidden, inter, topk = 16, 2048, 256, 8
+    k = jax.random.split(jax.random.key(0), 7)
+    real = jax.random.normal(k[0], (num_tokens, hidden)) / 10
+    perturbed = jax.random.normal(k[1], (num_tokens, hidden)) * 5
+    is_padding = jnp.arange(num_tokens)[:, None] >= num_valid
+    x = jnp.where(is_padding, perturbed, real).astype(jnp.bfloat16)
+    w1 = (jax.random.normal(k[2], (num_experts, hidden, 2 * inter)) * 64).astype(
+        jnp.float8_e4m3fn
+    )
+    w2 = (jax.random.normal(k[3], (num_experts, inter, hidden)) * 64).astype(
+        jnp.float8_e4m3fn
+    )
+    s1 = jax.random.uniform(
+        k[4], (num_experts, 1, 1, 2 * inter), minval=2e-4, maxval=4e-4
+    )
+    s2 = jax.random.uniform(k[5], (num_experts, 1, 1, hidden), minval=2e-4, maxval=4e-4)
+    rows = jnp.arange(num_tokens, dtype=jnp.int32)[:, None]
+    ids = (rows + 2 * jnp.arange(topk, dtype=jnp.int32)[None, :]) % num_experts
+    weights = jax.random.uniform(k[6], (num_tokens, topk), minval=0.05, maxval=0.3)
+    if num_valid > 0:
+        weights = weights.at[0, 0].set(0.0)
+    stock = fused_moe_func(
+        x, w1, w2, s1, s2, None, None, weights, ids, topk=topk, activation="silu"
+    )
+    row_count = fused_moe_func(
+        x,
+        w1,
+        w2,
+        s1,
+        s2,
+        None,
+        None,
+        weights,
+        ids,
+        None,
+        jnp.array([num_valid], dtype=jnp.int32),
+        topk=topk,
+        activation="silu",
+        skip_padded_tokens=True,
+        padded_row_filter=PaddedRowFilter.ROW_COUNT,
+    )
+    stock, row_count = np.asarray(stock), np.asarray(row_count)
+    np.testing.assert_array_equal(row_count[:num_valid], stock[:num_valid])
+    np.testing.assert_array_equal(
+        row_count[num_valid:], np.zeros_like(row_count[num_valid:])
+    )
+    if num_valid < num_tokens:
+        assert np.abs(stock[num_valid:].astype(np.float32)).max() > 0
+
