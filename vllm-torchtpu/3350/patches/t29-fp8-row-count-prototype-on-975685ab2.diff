+"""Experiment (t29): runner side of the FP8 MoE row-count filter (policy
+resolution from env + config, and the post-load finalize)."""
+
+from types import SimpleNamespace
+
+import torch
+from vllm.model_executor.layers.fused_moe import FusedMoEMethodBase
+
+from vllm_torchtpu.layers.adapter import moe_skip_policy as msp
+from vllm_torchtpu.layers.adapter.quantization.fp8 import (
+    VllmFp8Config,
+    VllmFp8MoEMethodTPU,
+)
+from vllm_torchtpu.runner.tpu_runner import TPUModelRunner
+
+_TOPK = 2
+_SKIP = "TPU_MOE_SKIP_PADDED_TOKENS"
+_RC = "TPU_MOE_SKIP_FP8_ROW_COUNT"
+
+
+def _parallel_config(**overrides):
+    cfg = {
+        "data_parallel_size": 1,
+        "pipeline_parallel_size": 1,
+        "prefill_context_parallel_size": 1,
+        "decode_context_parallel_size": 1,
+        "enable_expert_parallel": False,
+    }
+    cfg.update(overrides)
+    return SimpleNamespace(**cfg)
+
+
+def _method(*, row_count: bool) -> VllmFp8MoEMethodTPU:
+    method = VllmFp8MoEMethodTPU.__new__(VllmFp8MoEMethodTPU)
+    method._tpu_activation_str = "silu"
+    method._fp8_row_count = row_count
+    return method
+
+
+class _OtherMoEMethod(FusedMoEMethodBase):
+    def create_weights(self, *args, **kwargs):
+        raise AssertionError("not called")
+
+    def get_fused_moe_quant_config(self, layer):
+        raise AssertionError("not called")
+
+
+def _runner(monkeypatch):
+    for name in (
+        "TPU_MOE_COLLECTION_CHUNK_SIZE",
+        "TPU_MOE_FP8_ALL_GATHER",
+        "USE_MOE_FUSED_EP_KERNEL",
+        "MOE_FUSED_EP_KERNEL_IMPL",
+        "USE_MOE_TP_DECODE_KERNEL",
+        "FUSED_MOE_DECODE_KERNEL",
+        "TPU_MOE_DENSE_EXPERT_THRESHOLD",
+        "TPU_MOE_SEQUENCE_PARALLEL",
+        "MOE_REQUANTIZE_WEIGHT_DTYPE",
+        "MOE_REQUANTIZE_BLOCK_SIZE",
+    ):
+        monkeypatch.delenv(name, raising=False)
+    monkeypatch.setenv(_SKIP, "1")
+    monkeypatch.setenv(_RC, "1")
+    runner = object.__new__(TPUModelRunner)
+    runner.vllm_config = SimpleNamespace(
+        quant_config=VllmFp8Config.__new__(VllmFp8Config)
+    )
+    runner.vllm_config.quant_config.is_checkpoint_fp8_serialized = True
+    runner.parallel_config = _parallel_config()
+    runner.speculative_config = None
+    runner.drafter = None
+    runner.lora_config = None
+    return runner
+
+
+def test_runner_resolves_the_policy_from_env_and_config(monkeypatch):
+    runner = _runner(monkeypatch)
+    assert runner._resolve_fp8_row_count_policy().enabled is True
+    monkeypatch.setenv("USE_MOE_TP_DECODE_KERNEL", "1")
+    assert "fused MoE decode" in runner._resolve_fp8_row_count_policy().fallback_reason
+    monkeypatch.delenv("USE_MOE_TP_DECODE_KERNEL")
+    monkeypatch.setenv("MOE_FUSED_EP_KERNEL_IMPL", "adaptive")
+    assert "adaptive" in runner._resolve_fp8_row_count_policy().fallback_reason
+    monkeypatch.delenv("MOE_FUSED_EP_KERNEL_IMPL")
+    monkeypatch.setenv("TPU_MOE_DENSE_EXPERT_THRESHOLD", "64")
+    assert "dense-expert" in runner._resolve_fp8_row_count_policy().fallback_reason
+    monkeypatch.delenv("TPU_MOE_DENSE_EXPERT_THRESHOLD")
+    runner.vllm_config.quant_config = object()
+    assert runner._resolve_fp8_row_count_policy().fallback_reason == "not an FP8 model"
+
+
+def test_runner_finalize_keeps_pure_fp8_and_disarms_mixed(monkeypatch):
+    runner = _runner(monkeypatch)
+    on = runner._resolve_fp8_row_count_policy()
+    fp8 = _method(row_count=True)
+    fp8._checkpoint_weight_dtype = torch.float8_e4m3fn
+    fp8_mod = SimpleNamespace(
+        quant_method=fp8,
+        w13_weight=torch.zeros(2, 128, 128, dtype=torch.float8_e4m3fn),
+        w2_weight=torch.zeros(2, 64, 128, dtype=torch.float8_e4m3fn),
+        w13_weight_scale_inv=torch.ones(2, 1, 1, 128),
+        w2_weight_scale_inv=torch.ones(2, 1, 1, 128),
+    )
+    runner._fp8_row_count_policy = on
+    runner.model = SimpleNamespace(modules=lambda: [fp8_mod])
+    runner._finalize_fp8_row_count_policy_for_model()
+    assert runner._fp8_row_count_policy is on and fp8._fp8_row_count is True
+
+    disarmed: list[object] = []
+    monkeypatch.setattr(
+        VllmFp8MoEMethodTPU,
+        "disable_fp8_row_count",
+        lambda self, layer=None: disarmed.append(layer),
+    )
+    other_mod = SimpleNamespace(quant_method=object.__new__(_OtherMoEMethod))
+    runner._fp8_row_count_policy = on
+    runner.model = SimpleNamespace(modules=lambda: [fp8_mod, other_mod])
+    runner._finalize_fp8_row_count_policy_for_model()
+    assert runner._fp8_row_count_policy.enabled is False
+    assert runner._fp8_row_count_policy.fallback_reason.startswith("MoE methods")
+    assert disarmed == [fp8_mod]
+
+    runner._fp8_row_count_policy = on
+    runner.model = SimpleNamespace(modules=lambda: [SimpleNamespace()])
+    runner._finalize_fp8_row_count_policy_for_model()
+    assert runner._fp8_row_count_policy.fallback_reason == "model has no MoE layers"
+
+
+def test_runner_rejects_off_contract_loads_and_allocates_no_fp8_count(monkeypatch):
+    """Quantize-on-load, int8 / e5m2 requantization, a non-default runtime block
+    size and a loaded layer outside the contract keep the existing path and
+    allocate no valid-token count for FP8; the BF16 policy's need is unaffected."""
+    runner = _runner(monkeypatch)
+    runner._bf16_moe_skip_policy = msp.Bf16MoeSkipPolicy(enabled=False)
+    quant_config = runner.vllm_config.quant_config
+    quant_config.is_checkpoint_fp8_serialized = False
+    assert "quantize-on-load" in runner._resolve_fp8_row_count_policy().fallback_reason
+    quant_config.is_checkpoint_fp8_serialized = True
+    for name, value, fragment in (
+        ("MOE_REQUANTIZE_WEIGHT_DTYPE", "int8", "int8"),
+        ("MOE_REQUANTIZE_WEIGHT_DTYPE", "float8_e5m2", "float8_e5m2"),
+        ("MOE_REQUANTIZE_BLOCK_SIZE", "128", "MOE_REQUANTIZE_BLOCK_SIZE=128"),
+    ):
+        monkeypatch.setenv(name, value)
+        policy = runner._resolve_fp8_row_count_policy()
+        assert policy.enabled is False and fragment in policy.fallback_reason
+        monkeypatch.delenv(name)
+    on = runner._resolve_fp8_row_count_policy()
+    assert on.enabled is True
+    runner._fp8_row_count_policy = on
+    assert runner._padding_state_tracks_valid_tokens() is True
+
+    fp8 = _method(row_count=True)
+    fp8._checkpoint_weight_dtype = torch.float8_e4m3fn
+    bad = SimpleNamespace(
+        w13_weight=torch.zeros(2, 128, 128, dtype=torch.float8_e4m3fn),
+        w2_weight=torch.zeros(2, 64, 128, dtype=torch.float8_e4m3fn),
+        w13_weight_scale_inv=torch.ones(2, 1, 1, 128),
+        w2_weight_scale_inv=torch.ones(2, 2, 1, 128),  # block scales
+        quant_method=fp8,
+    )
+    monkeypatch.setattr(
+        VllmFp8MoEMethodTPU, "disable_fp8_row_count", lambda self, layer=None: None
+    )
+    runner.model = SimpleNamespace(modules=lambda: [bad])
+    runner._finalize_fp8_row_count_policy_for_model()
+    assert runner._fp8_row_count_policy.enabled is False
+    assert (
+        "load contract: w2 runtime scale"
+        in runner._fp8_row_count_policy.fallback_reason
+    )
+    assert runner._padding_state_tracks_valid_tokens() is False
+    runner._bf16_moe_skip_policy = msp.Bf16MoeSkipPolicy(enabled=True)
+    assert runner._padding_state_tracks_valid_tokens() is True
